# Backend Environment Variables (Private Server-Side Only)
APP_NAME="Suraksha Path API"
ENVIRONMENT="production"
DEBUG=false

# Database Configuration (PostgreSQL recommended for persistent Vercel deployments):
# DATABASE_URL="postgresql://user:password@host:port/database"
DATABASE_URL="sqlite:////tmp/suraksha_path.db"

# Administrative & Moderation Secret
MODERATOR_KEY="replace-with-a-cryptographically-random-secret"

# CORS configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,https://suraksha-path.vercel.app"
