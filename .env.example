# ==============================================================================
# SURAKSHA PATH ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# FOR VERCEL DEPLOYMENTS:
# Set these variables in the Vercel Dashboard under:
# Project Settings -> Environment Variables.
#
# FRONTEND VARIABLES (Exposed to the browser via Vite bundle):
# - VITE_MAPBOX_TOKEN
# - VITE_MAP_PROVIDER
# - VITE_API_BASE_URL (Optional on Vercel: defaults automatically to same-origin /api)
#
# BACKEND VARIABLES (Kept private and secure inside serverless functions):
# - DATABASE_URL (External PostgreSQL recommended for persistent records)
# - MODERATOR_KEY (Cryptographic secret for civic moderation actions)
# - ENVIRONMENT (Set to "production" on Vercel)
# - DEBUG (Set to "false" on Vercel)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Client-side)
# ------------------------------------------------------------------------------
# Mapbox public access token (e.g. pk.eyJ1...):
VITE_MAPBOX_TOKEN="pk.eyJ1IjoieW91ci11c2VybmFtZSIsImEiOiJ5b3VyLXRva2VuIn0.example"
VITE_MAP_PROVIDER="MAPBOX"

# Frontend API base URL.
# - For local development: http://127.0.0.1:8000/api
# - For Vercel production: Leave blank or set to /api (uses same-origin rewrite)
VITE_API_BASE_URL="/api"

# Optional custom basemap tile server override:
# VITE_MAP_TILE_URL="https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png"
# VITE_MAP_ATTRIBUTION="&copy; OpenStreetMap contributors &copy; CARTO"

# ------------------------------------------------------------------------------
# 2. BACKEND SERVICE ENVIRONMENT VARIABLES (Server-side Only)
# ------------------------------------------------------------------------------
APP_NAME="Suraksha Path API"
ENVIRONMENT="production"
DEBUG=false
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000

# Database Configuration:
# - Local default: sqlite:///./data/suraksha_path.db
# - Vercel ephemeral default: sqlite:////tmp/suraksha_path.db (auto-seeded on cold start)
# - Vercel persistent production: postgresql://user:password@host:port/database (e.g. Neon, Supabase, Vercel Postgres)
DATABASE_URL="sqlite:////tmp/suraksha_path.db"

# Geospatial Default Context (Chennai, India)
DEFAULT_CITY="Chennai, India"
DEFAULT_CENTER_LAT=13.0827
DEFAULT_CENTER_LNG=80.2707

# Routing Engine Configuration (OSRM with OpenStreetMap Road Network)
OSRM_ROUTER_URL="https://router.project-osrm.org"
ROUTING_TIMEOUT_SECONDS=8.0
ROUTING_PROVIDER_NAME="OpenStreetMap / OSRM Driving Engine"
ENABLE_OFFLINE_CORRIDOR_FALLBACK=true

# Security & Administrative Authentication
# Replace with a cryptographically random secret in production (e.g. openssl rand -hex 32)
MODERATOR_KEY="replace-with-a-cryptographically-random-secret"
ENABLE_RATE_LIMITING=true

# Allowed CORS Origins (comma-separated). Vercel subdomains (*.vercel.app) are allowed by default.
CORS_ORIGINS="https://suraksha-path.vercel.app,http://localhost:5173"
