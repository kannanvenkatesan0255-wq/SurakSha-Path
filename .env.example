# ==============================================================================
# SURAKSHA PATH ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# NOTE: All defaults are designed for immediate zero-credential local execution.
# No paid or external API keys are required to run the local prototype.
# ==============================================================================

# Backend Configuration
APP_NAME="Suraksha Path API"
ENVIRONMENT=development
DEBUG=true
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Database Configuration
# Default is a local SQLite database in the /data folder
DATABASE_URL=sqlite:///./data/suraksha_path.db

# Geospatial Context
DEFAULT_CITY="Chennai, India"
DEFAULT_CENTER_LAT=13.0827
DEFAULT_CENTER_LNG=80.2707

# Frontend Configuration (exposed to Vite via VITE_ prefix)
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Map Provider Configuration (Phase 4 / Phase 20)
# Configure a Mapbox public access token (e.g. pk.eyJ1...) for premium basemap styles:
VITE_MAPBOX_TOKEN=""
VITE_MAP_PROVIDER="MAPBOX"
# Optional fallback tile server or proxy:
# VITE_MAP_TILE_URL=""
# VITE_MAP_ATTRIBUTION=""

# Routing Engine Configuration (Phase 6)
# Default is the public OpenStreetMap / OSRM driving engine
OSRM_ROUTER_URL="https://router.project-osrm.org"
ROUTING_TIMEOUT_SECONDS=8.0
ROUTING_PROVIDER_NAME="OpenStreetMap / OSRM Driving Engine"
ENABLE_OFFLINE_CORRIDOR_FALLBACK=True

# Security & Administrative Authentication (Phase 17)
# CRITICAL: For production deployments, replace this placeholder with a cryptographically
# random secret (e.g. openssl rand -hex 32). Never commit actual production keys to git!
MODERATOR_KEY="suraksha-chennai-moderator-2026"
ENABLE_RATE_LIMITING=true
