# ==============================================================================
# SURAKSHA PATH ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# NOTE: All defaults are designed for immediate zero-credential local execution.
# No paid or external API keys are required to run the local prototype.
# ==============================================================================

# Backend Configuration
APP_NAME="Suraksha Path API"
ENVIRONMENT=development
DEBUG=true
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Database Configuration
# Default is a local SQLite database in the /data folder
DATABASE_URL=sqlite:///./data/suraksha_path.db

# Geospatial Context
DEFAULT_CITY="Chennai, India"
DEFAULT_CENTER_LAT=13.0827
DEFAULT_CENTER_LNG=80.2707

# Frontend Configuration (exposed to Vite via VITE_ prefix)
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Optional Map Provider Configuration (Future expansion)
# VITE_MAPBOX_TOKEN=
# VITE_STADIA_MAPS_KEY=

# Optional Routing Engine API (Defaults to synthetic Chennai graph fallback)
# OSRM_ROUTER_URL=http://router.project-osrm.org
